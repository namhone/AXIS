NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/axis_auth
JWT_ACCESS_SECRET=replace-with-a-random-value-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-value-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=axis_refresh_token
FRONTEND_ORIGIN=http://127.0.0.1:5500
# Production có thể khai báo nhiều origin, phân tách bằng dấu phẩy.
# FRONTEND_ORIGIN=https://axis.example.com,https://www.axis.example.com

# Production bắt buộc dùng HTTPS và cookie Secure.
# NODE_ENV=production
# FRONTEND_ORIGIN=https://your-frontend.example.com
