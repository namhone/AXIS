<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phát triển bản thân — FuturePath</title>
    <link rel="stylesheet" href="../css/global.css" />
  </head>
  <body>
    <div class="page-shell">
      

      <div class="workspace">
        <header class="topbar">
          <div class="header-brand">
            <a class="brand-link" href="../index.html">
              <div class="brand">
                <div class="brand-mark" aria-hidden="true">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-mark-inner-svg" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="4" fill="currentColor" />
                    <path d="M7 12h10M12 7v10" stroke="rgba(255,255,255,0.9)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="brand-copy"><span>FuturePath</span><small>Đồng hành cùng cuộc đời</small></div>
              </div>
            </a>
          </div>

          <nav class="header-nav" role="navigation" aria-label="Chính">
            <a class="nav-item" href="profile.html"><span class="nav-ico">☰</span><span>Hồ sơ năng lực</span></a>
            <a class="nav-item" href="assessment.html"><span class="nav-ico">◎</span><span>Đánh giá &amp; Gợi ý</span></a>
            <a class="nav-item active" href="development.html"><span class="nav-ico">▣</span><span>Phát triển bản thân</span></a>
            <a class="nav-item" href="careers.html"><span class="nav-ico">▤</span><span>Thư viện nghề nghiệp</span></a>
            <a class="nav-item" href="about.html"><span class="nav-ico">ⓘ</span><span>Về dự án</span></a>
          </nav>

          <div class="header-auth">
            <div class="auth-area" id="authArea">
              <button class="auth-btn ghost-btn" type="button" data-auth-action="signin">Đăng nhập</button>
              <button class="auth-btn primary-btn" type="button" data-auth-action="signup">Đăng ký</button>
            </div>
          </div>
        </header>

        <main class="main-column">
          <section class="page-hero">
            <span class="eyebrow">Phát triển bản thân</span>
            <h1>Biến gợi ý thành hành động.</h1>
            <p class="lead">Chọn mục tiêu, xác định kỹ năng cần phát triển và theo dõi tiến độ.</p>
          </section>

          <section class="content-panel">
            <h2>01 · Mục tiêu hiện tại</h2>
            <div class="info-grid">
              <article class="stat-card">
                <h3>Hướng đến</h3>
                <p><strong>Khoa học dữ liệu</strong></p>
                <p>Mục tiêu 8 tuần: hoàn thiện nền tảng Python và tiếng Anh chuyên ngành.</p>
              </article>
              <article class="stat-card">
                <h3>Python</h3>
                <div class="progress-row">
                  <div class="label"><span>Tiến độ</span><strong>62%</strong></div>
                  <div class="progress-bar"><span style="width:62%"></span></div>
                </div>
              </article>
              <article class="stat-card">
                <h3>Tiếng Anh</h3>
                <div class="progress-row">
                  <div class="label"><span>Tiến độ</span><strong>67%</strong></div>
                  <div class="progress-bar"><span class="progress-fill" data-progress="67"></span></div>
                </div>
              </article>
            </div>
          </section>

          <section class="content-panel">
            <h2>02 · Lộ trình</h2>
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-badge">01</div>
                <div>
                  <strong>Học Python cơ bản</strong>
                  <p>Tuần 1–2 · 4 bài học</p>
                </div>
                <span class="status">Đã xong</span>
              </div>
              <div class="timeline-item">
                <div class="timeline-badge">02</div>
                <div>
                  <strong>Thực hiện mini project</strong>
                  <p>Tuần 3–4 · 1 dự án</p>
                </div>
                <span class="status">Đang làm</span>
              </div>
              <div class="timeline-item">
                <div class="timeline-badge">03</div>
                <div>
                  <strong>Cải thiện tiếng Anh chuyên ngành</strong>
                  <p>Tuần 5–8 · 3 module</p>
                </div>
                <span class="status pending">Chưa bắt đầu</span>
              </div>
            </div>
          </section>

          <section class="content-panel" id="developmentWorkspace">
            <h2>03 · Kế hoạch &amp; Mục tiêu (Nhật ký hành động)</h2>

            <div class="controls-row" style="margin-bottom:12px;">
              <input type="text" id="goalTitle" class="input-compact" placeholder="Mục tiêu / Nhiệm vụ (ví dụ: Hoàn thành bài tập Python)" />
              <input type="text" id="goalWhen" class="input-compact input-compact--fixed" placeholder="Thời gian (ví dụ: Tuần 1–2)" />
            </div>

            <div class="controls-row" style="margin-bottom:12px;">
              <input type="text" id="goalNote" class="input-compact" placeholder="Ghi chú ngắn (ví dụ: xem kênh học, trang tập)" />
              <select id="goalCategory" class="input-compact input-compact--select">
                <option value="general">Chung</option>
                <option value="study">Học tập</option>
                <option value="project">Dự án</option>
                <option value="skill">Kỹ năng</option>
              </select>
              <button class="primary-btn" id="addGoal">Thêm</button>
            </div>

            <div class="controls-row" style="margin-bottom:12px; gap:12px;">
              <button class="ghost-btn" id="savePlan">Lưu kế hoạch</button>
              <button class="ghost-btn" id="exportPlan">Xuất kế hoạch (PDF)</button>
              <button class="ghost-btn" id="clearPlan">Xóa toàn bộ (demo)</button>
            </div>

            <div id="goalsList" class="timeline" aria-live="polite">
              <!-- goals rendered here -->
            </div>

            <p class="muted">Ghi chú: tính năng lưu là demo dùng localStorage. Để lưu thật cần backend.</p>
          </section>
        </main>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-contact">
          <h4>Liên hệ</h4>
          <p>FuturePath — Hỗ trợ định hướng nghề nghiệp và phát triển kỹ năng cho học sinh.</p>
          <p><strong>Email:</strong> <a href="mailto:hello@futurepath.vn">hello@futurepath.vn</a></p>
          <p><strong>Điện thoại:</strong> <a href="tel:+840123456789">+84 0123 456 789</a></p>
        </div>

        <div class="footer-form">
          <h4>Nhận thông tin &amp; tư vấn</h4>
          <form id="contactForm" action="#" onsubmit="event.preventDefault(); alert('Cảm ơn! Chúng tôi sẽ liên hệ sớm.');">
            <div class="field-row">
              <input type="email" name="email" placeholder="Email của bạn" required />
              <input type="tel" name="phone" placeholder="Số điện thoại (tùy chọn)" />
            </div>
            <div class="field-row">
              <button type="submit" class="primary-btn">Gửi</button>
              <button type="reset" class="ghost-btn">Xóa</button>
            </div>
          </form>
        </div>
      </div>
      <div class="footer-bottom">© 2026 FuturePath — All rights reserved.</div>
    </footer>

    <div class="settings-modal hidden" id="settingsModal" aria-hidden="true">
      <div class="settings-modal-backdrop" data-close-settings="true"></div>
      <div class="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
        <div class="settings-header">
          <h3 id="settingsTitle">Cài đặt tài khoản</h3>
          <button type="button" class="settings-close" id="closeSettingsModal" aria-label="Đóng cài đặt">×</button>
        </div>
        <div class="settings-list">
          <label class="setting-item"><span>Thông báo email</span><input type="checkbox" checked /></label>
          <label class="setting-item"><span>Gợi ý nghề nghiệp tự động</span><input type="checkbox" checked /></label>
          <label class="setting-item"><span>Bảo mật 2 lớp</span><input type="checkbox" /></label>
          <label class="setting-item"><span>Chế độ tối</span><input type="checkbox" /></label>
        </div>
        <div class="settings-actions">
          <button type="button" class="ghost-btn" data-close-settings="true">Hủy</button>
          <button type="button" class="primary-btn" id="saveSettings">Lưu thay đổi</button>
        </div>
      </div>
    </div>

    <script>
      (function(){
        const authArea = document.getElementById('authArea');
        const userPanel = document.getElementById('userPanel');
        const userChip = document.getElementById('userChip');
        const userMenu = document.getElementById('userMenu');
        const menuButtons = document.querySelectorAll('[data-menu-action]');
        const authButtons = document.querySelectorAll('[data-auth-action]');
        const AUTH_KEY = 'futurepath.signed_in';

        const setSignedIn = (opts) => {
          try { localStorage.setItem(AUTH_KEY, '1'); } catch (e) {}
          if (authArea) authArea.classList.add('hidden');
          if (userPanel) userPanel.classList.remove('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
        };

        const setSignedOut = (opts) => {
          try { localStorage.removeItem(AUTH_KEY); } catch (e) {}
          if (authArea) authArea.classList.remove('hidden');
          if (userPanel) userPanel.classList.add('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
        };

        authButtons.forEach(function (button) {
          button.addEventListener('click', function () { setSignedIn(); });
        });

        try { if (localStorage.getItem(AUTH_KEY)) setSignedIn({ silent: true }); } catch (e) {}

        if (userChip) {
          userChip.addEventListener('click', function () {
            if (!userMenu) return;
            const isHidden = userMenu.classList.contains('hidden');
            userMenu.classList.toggle('hidden', !isHidden);
            userChip.setAttribute('aria-expanded', String(isHidden));
          });
        }

        menuButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            const action = button.getAttribute('data-menu-action');
            if (action === 'settings') {
              const modal = document.getElementById('settingsModal');
              if (modal) modal.classList.remove('hidden');
            } else if (action === 'logout') {
              setSignedOut();
            } else {
              alert('Tính năng chưa được triển khai trong phiên bản demo.');
            }
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded', 'false');
          });
        });

        const modal = document.getElementById('settingsModal');
        const closeModal = document.getElementById('closeSettingsModal');
        const saveSettings = document.getElementById('saveSettings');
        const closeTriggers = document.querySelectorAll('[data-close-settings="true"]');

        closeModal && closeModal.addEventListener('click', function () { modal && modal.classList.add('hidden'); });
        closeTriggers.forEach(function (trigger) { trigger.addEventListener('click', function () { modal && modal.classList.add('hidden'); }); });
        saveSettings && saveSettings.addEventListener('click', function () { alert('Cài đặt đã được lưu thành công.'); modal && modal.classList.add('hidden'); });

        document.addEventListener('click', function (event) {
          if (!userMenu || !userChip) return;
          if (!userMenu.contains(event.target) && !userChip.contains(event.target)) {
            userMenu.classList.add('hidden');
            userChip.setAttribute('aria-expanded', 'false');
          }
        });
      })();

      (function(){
        // Header-nav is now the single source of truth. Attach safe click handlers to header nav items.
        const headerNav = document.querySelector('.header-nav');
        if (!headerNav) return;
        const navLinks = headerNav.querySelectorAll('.nav-item');

        navLinks.forEach(function (link) {
          link.addEventListener('click', function (e) {
            // Toggle active state
            navLinks.forEach(function (l){ l.classList.remove('active'); });
            link.classList.add('active');

            // Close user menu if open
            const userMenu = document.getElementById('userMenu');
            const userChip = document.getElementById('userChip');
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded','false');
          });
        });

        headerNav.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            const item = e.target.closest('.nav-item');
            if (item) { item.click(); e.preventDefault(); }
          }
        });
      })();

      // Development page JS: manage goals / plan
      (function(){
        const goalsKey = 'futurepath.goals';
        const addBtn = document.getElementById('addGoal');
        const titleInput = document.getElementById('goalTitle');
        const whenInput = document.getElementById('goalWhen');
        const noteInput = document.getElementById('goalNote');
        const categoryInput = document.getElementById('goalCategory');
        const listEl = document.getElementById('goalsList');
        const saveBtn = document.getElementById('savePlan');
        const exportBtn = document.getElementById('exportPlan');
        const clearBtn = document.getElementById('clearPlan');

        function loadGoals() {
          try { return JSON.parse(localStorage.getItem(goalsKey) || '[]'); } catch (e) { return []; }
        }
        function saveGoals(goals) {
          try { localStorage.setItem(goalsKey, JSON.stringify(goals)); } catch (e) { console.error(e); }
        }

        function render() {
          const goals = loadGoals();
          listEl.innerHTML = '';
          if (!goals.length) {
            listEl.innerHTML = '<div class="timeline-item"><div><em>Chưa có mục tiêu nào. Thêm mục tiêu phía trên để bắt đầu.</em></div></div>';
            return;
          }
          goals.forEach(function(g, idx){
            const item = document.createElement('div');
            item.className = 'timeline-item';
            item.innerHTML = `
              <div class="timeline-badge">${String(idx+1).padStart(2,'0')}</div>
              <div>
                <div class="goal-header">
                  <strong class="goal-title">${escapeHtml(g.title)}</strong>
                  <small class="goal-when">${escapeHtml(g.when || '')}</small>
                  <small class="goal-category">${escapeHtml(g.category || 'Chung')}</small>
                </div>
                <p class="goal-note">${escapeHtml(g.note || '')}</p>
              </div>
              <div class="timeline-actions">
                <button class="ghost-btn toggle-complete" data-idx="${idx}">${g.done ? 'Hoàn thành' : 'Đánh dấu'}</button>
                <button class="ghost-btn delete-goal" data-idx="${idx}">Xóa</button>
              </div>
            `;
            if (g.done) {
              const status = document.createElement('span'); status.className='status'; status.textContent='Đã xong';
              item.appendChild(status);
            }
            listEl.appendChild(item);
          });
          attachListHandlers();
          // update progress fills after render
          try { updateProgressFills(); } catch (e) { /* ignore if not available */ }
        }

        // update progress-fill elements from data-progress
        function updateProgressFills(){
          document.querySelectorAll('.progress-fill').forEach(function(el){
            let v = el.getAttribute('data-progress') || el.dataset.progress || '';
            if (!v) return;
            v = String(v).trim();
            if (v.endsWith('%')) v = v.slice(0, -1);
            if (v && !isNaN(Number(v))) el.style.setProperty('--progress', v + '%');
          });
        }

        function attachListHandlers() {
          listEl.querySelectorAll('.toggle-complete').forEach(function(btn){
            btn.addEventListener('click', function(){
              const i = Number(btn.getAttribute('data-idx'));
              const goals = loadGoals();
              if (!goals[i]) return;
              goals[i].done = !goals[i].done;
              saveGoals(goals);
              render();
            });
          });
          listEl.querySelectorAll('.delete-goal').forEach(function(btn){
            btn.addEventListener('click', function(){
              const i = Number(btn.getAttribute('data-idx'));
              const goals = loadGoals();
              goals.splice(i,1);
              saveGoals(goals);
              render();
            });
          });
        }

        function escapeHtml(s){ if(!s) return ''; return String(s).replace(/[&<>"]+/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

        if (addBtn) {
          // support Enter key on the title or note to add
          [titleInput, noteInput].forEach(function(inp){
            inp && inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); addBtn.click(); } });
          });

          addBtn.addEventListener('click', function(){
            const t = titleInput.value && titleInput.value.trim();
            if (!t) { alert('Vui lòng nhập tiêu đề mục tiêu.'); return; }
            const w = whenInput.value && whenInput.value.trim();
            const n = noteInput.value && noteInput.value.trim();
            const c = categoryInput.value || 'general';
            const goals = loadGoals();
            goals.push({ title: t, when: w, note: n, category: c, done: false, created: Date.now() });
            saveGoals(goals);
            titleInput.value = ''; whenInput.value = ''; noteInput.value = ''; categoryInput.value = 'general';
            render();
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener('click', function(){
            const goals = loadGoals();
            if (!goals.length) { alert('Không có mục tiêu nào để lưu.'); return; }
            // already persisted; notify user
            alert('Kế hoạch đã được lưu (localStorage, demo).');
          });
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', function(){
            if (!confirm('Xóa toàn bộ kế hoạch? (demo, sẽ xóa localStorage)')) return;
            saveGoals([]); render();
          });
        }

        if (exportBtn) {
          exportBtn.addEventListener('click', function(){
            const goals = loadGoals();
            if (!goals.length) { alert('Không có mục tiêu để xuất.'); return; }
            const { jsPDF } = window.jspdf || {};
            if (jsPDF) {
              const doc = new jsPDF({ unit:'pt', format:'a4' });
              doc.setFontSize(16); doc.text('FuturePath — Kế hoạch phát triển cá nhân', 40, 60);
              doc.setFontSize(11); doc.text('Thời gian: ' + new Date().toLocaleString(), 40, 84);
              let y = 110;
              goals.forEach(function(g, i){
                const line = (i+1)+'. ' + g.title + (g.when?(' — '+g.when):'') + (g.done?(' [Đã xong]'):'');
                const wrapped = doc.splitTextToSize(line, 520);
                doc.text(wrapped, 40, y);
                y += (wrapped.length*14) + 8;
                if (y > 750) { doc.addPage(); y = 50; }
              });
              doc.save('futurepath-plan.pdf');
            } else {
              const blob = new Blob([JSON.stringify(goals, null, 2)], { type: 'application/json' });
              const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'futurepath-plan.json'; document.body.appendChild(a); a.click(); a.remove();
            }
          });
        }

        // initial render
        try { render(); } catch (e) { console.error(e); }
      })();

    </script>
  </body>
</html>



