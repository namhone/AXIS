    <div class="settings-modal hidden" id="settingsModal" aria-hidden="true">
      <div class="settings-modal-backdrop" data-close-settings="true"></div>
      <div class="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
        <div class="settings-header">
          <h3 id="settingsTitle">CÃ i Ä‘áº·t tÃ i khoáº£n</h3>
          <button type="button" class="settings-close" id="closeSettingsModal" aria-label="ÄÃ³ng cÃ i Ä‘áº·t">Ã—</button>
        </div>
        <div class="settings-list">
          <label class="setting-item"><span>ThÃ´ng bÃ¡o email</span><input type="checkbox" checked /></label>
          <label class="setting-item"><span>Gá»£i Ã½ nghá» nghiá»‡p tá»± Ä‘á»™ng</span><input type="checkbox" checked /></label>
          <label class="setting-item"><span>Báº£o máº­t 2 lá»›p</span><input type="checkbox" /></label>
          <label class="setting-item"><span>Cháº¿ Ä‘á»™ tá»‘i</span><input type="checkbox" /></label>
        </div>
        <div class="settings-actions">
          <button type="button" class="ghost-btn" data-close-settings="true">Há»§y</button>
          <button type="button" class="primary-btn" id="saveSettings">LÆ°u thay Ä‘á»•i</button>
        </div>
      </div>
    </div>

    <script>
      (function(){
        const authArea = document.getElementById('authArea');
        const userPanel = document.getElementById('userPanel');
        const userChip = document.getElementById('userChip');
        const userMenu = document.getElementById('userMenu');
        const menuButtons = document.querySelectorAll('[data-menu-action]');
        const authButtons = document.querySelectorAll('[data-auth-action]');
        const AUTH_KEY = 'futurepath.signed_in';

        const setSignedIn = (opts) => {
          try { localStorage.setItem(AUTH_KEY, '1'); } catch (e) {}
          if (authArea) authArea.classList.add('hidden');
          if (userPanel) userPanel.classList.remove('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
        };

        const setSignedOut = (opts) => {
          try { localStorage.removeItem(AUTH_KEY); } catch (e) {}
          if (authArea) authArea.classList.remove('hidden');
          if (userPanel) userPanel.classList.add('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
        };

        authButtons.forEach(function (button) {
          button.addEventListener('click', function () { setSignedIn(); });
        });

        try { if (localStorage.getItem(AUTH_KEY)) setSignedIn({ silent: true }); } catch (e) {}

        if (userChip) {
          userChip.addEventListener('click', function () {
            if (!userMenu) return;
            const isHidden = userMenu.classList.contains('hidden');
            userMenu.classList.toggle('hidden', !isHidden);
            userChip.setAttribute('aria-expanded', String(isHidden));
          });
        }

        menuButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            const action = button.getAttribute('data-menu-action');
            if (action === 'settings') {
              const modal = document.getElementById('settingsModal');
              if (modal) modal.classList.remove('hidden');
            } else if (action === 'logout') {
              setSignedOut();
            } else {
              alert('TÃ­nh nÄƒng chÆ°a Ä‘Æ°á»£c triá»ƒn khai trong phiÃªn báº£n demo.');
            }
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded', 'false');
          });
        });

        const modal = document.getElementById('settingsModal');
        const closeModal = document.getElementById('closeSettingsModal');
        const saveSettings = document.getElementById('saveSettings');
        const closeTriggers = document.querySelectorAll('[data-close-settings="true"]');

        closeModal && closeModal.addEventListener('click', function () { modal && modal.classList.add('hidden'); });
        closeTriggers.forEach(function (trigger) { trigger.addEventListener('click', function () { modal && modal.classList.add('hidden'); }); });
        saveSettings && saveSettings.addEventListener('click', function () { alert('CÃ i Ä‘áº·t Ä‘Ã£ Ä‘Æ°á»£c lÆ°u thÃ nh cÃ´ng.'); modal && modal.classList.add('hidden'); });

        document.addEventListener('click', function (event) {
          if (!userMenu || !userChip) return;
          if (!userMenu.contains(event.target) && !userChip.contains(event.target)) {
            userMenu.classList.add('hidden');
            userChip.setAttribute('aria-expanded', 'false');
          }
        });
      })();

      (function(){
        // Header-nav is now the single source of truth. Attach safe click handlers to header nav items.
        const headerNav = document.querySelector('.header-nav');
        if (!headerNav) return;
        const navLinks = headerNav.querySelectorAll('.nav-item');

        navLinks.forEach(function (link) {
          link.addEventListener('click', function (e) {
            // Toggle active state
            navLinks.forEach(function (l){ l.classList.remove('active'); });
            link.classList.add('active');

            // Close user menu if open
            const userMenu = document.getElementById('userMenu');
            const userChip = document.getElementById('userChip');
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded','false');
          });
        });

        headerNav.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            const item = e.target.closest('.nav-item');
            if (item) { item.click(); e.preventDefault(); }
          }
        });
      })();

      // Development page JS: manage goals / plan
      (function(){
        const goalsKey = 'futurepath.goals';
        const addBtn = document.getElementById('addGoal');
        const titleInput = document.getElementById('goalTitle');
        const whenInput = document.getElementById('goalWhen');
        const noteInput = document.getElementById('goalNote');
        const categoryInput = document.getElementById('goalCategory');
        const listEl = document.getElementById('goalsList');
        const saveBtn = document.getElementById('savePlan');
        const exportBtn = document.getElementById('exportPlan');
        const clearBtn = document.getElementById('clearPlan');

        function loadGoals() {
          try { return JSON.parse(localStorage.getItem(goalsKey) || '[]'); } catch (e) { return []; }
        }
        function saveGoals(goals) {
          try { localStorage.setItem(goalsKey, JSON.stringify(goals)); } catch (e) { console.error(e); }
        }

        function render() {
          const goals = loadGoals();
          listEl.innerHTML = '';
          if (!goals.length) {
            listEl.innerHTML = '<div class="timeline-item"><div><em>ChÆ°a cÃ³ má»¥c tiÃªu nÃ o. ThÃªm má»¥c tiÃªu phÃ­a trÃªn Ä‘á»ƒ báº¯t Ä‘áº§u.</em></div></div>';
            return;
          }
          goals.forEach(function(g, idx){
            const item = document.createElement('div');
            item.className = 'timeline-item';
            item.innerHTML = `
              <div class="timeline-badge">${String(idx+1).padStart(2,'0')}</div>
              <div>
                <div class="goal-header">
                  <strong class="goal-title">${escapeHtml(g.title)}</strong>
                  <small class="goal-when">${escapeHtml(g.when || '')}</small>
                  <small class="goal-category">${escapeHtml(g.category || 'Chung')}</small>
                </div>
                <p class="goal-note">${escapeHtml(g.note || '')}</p>
              </div>
              <div class="timeline-actions">
                <button class="ghost-btn toggle-complete" data-idx="${idx}">${g.done ? 'HoÃ n thÃ nh' : 'ÄÃ¡nh dáº¥u'}</button>
                <button class="ghost-btn delete-goal" data-idx="${idx}">XÃ³a</button>
              </div>
            `;
            if (g.done) {
              const status = document.createElement('span'); status.className='status'; status.textContent='ÄÃ£ xong';
              item.appendChild(status);
            }
            listEl.appendChild(item);
          });
          attachListHandlers();
          // update progress fills after render
          try { updateProgressFills(); } catch (e) { /* ignore if not available */ }
        }

        // update progress-fill elements from data-progress
        function updateProgressFills(){
          document.querySelectorAll('.progress-fill').forEach(function(el){
            let v = el.getAttribute('data-progress') || el.dataset.progress || '';
            if (!v) return;
            v = String(v).trim();
            if (v.endsWith('%')) v = v.slice(0, -1);
            if (v && !isNaN(Number(v))) el.style.setProperty('--progress', v + '%');
          });
        }

        function attachListHandlers() {
          listEl.querySelectorAll('.toggle-complete').forEach(function(btn){
            btn.addEventListener('click', function(){
              const i = Number(btn.getAttribute('data-idx'));
              const goals = loadGoals();
              if (!goals[i]) return;
              goals[i].done = !goals[i].done;
              saveGoals(goals);
              render();
            });
          });
          listEl.querySelectorAll('.delete-goal').forEach(function(btn){
            btn.addEventListener('click', function(){
              const i = Number(btn.getAttribute('data-idx'));
              const goals = loadGoals();
              goals.splice(i,1);
              saveGoals(goals);
              render();
            });
          });
        }

        function escapeHtml(s){ if(!s) return ''; return String(s).replace(/[&<>"]+/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

        if (addBtn) {
          // support Enter key on the title or note to add
          [titleInput, noteInput].forEach(function(inp){
            inp && inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); addBtn.click(); } });
          });

          addBtn.addEventListener('click', function(){
            const t = titleInput.value && titleInput.value.trim();
            if (!t) { alert('Vui lÃ²ng nháº­p tiÃªu Ä‘á» má»¥c tiÃªu.'); return; }
            const w = whenInput.value && whenInput.value.trim();
            const n = noteInput.value && noteInput.value.trim();
            const c = categoryInput.value || 'general';
            const goals = loadGoals();
            goals.push({ title: t, when: w, note: n, category: c, done: false, created: Date.now() });
            saveGoals(goals);
            titleInput.value = ''; whenInput.value = ''; noteInput.value = ''; categoryInput.value = 'general';
            render();
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener('click', function(){
            const goals = loadGoals();
            if (!goals.length) { alert('KhÃ´ng cÃ³ má»¥c tiÃªu nÃ o Ä‘á»ƒ lÆ°u.'); return; }
            // already persisted; notify user
            alert('Káº¿ hoáº¡ch Ä‘Ã£ Ä‘Æ°á»£c lÆ°u (localStorage, demo).');
          });
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', function(){
            if (!confirm('XÃ³a toÃ n bá»™ káº¿ hoáº¡ch? (demo, sáº½ xÃ³a localStorage)')) return;
            saveGoals([]); render();
          });
        }

        if (exportBtn) {
          exportBtn.addEventListener('click', function(){
            const goals = loadGoals();
            if (!goals.length) { alert('KhÃ´ng cÃ³ má»¥c tiÃªu Ä‘á»ƒ xuáº¥t.'); return; }
            const { jsPDF } = window.jspdf || {};
            if (jsPDF) {
              const doc = new jsPDF({ unit:'pt', format:'a4' });
              doc.setFontSize(16); doc.text('FuturePath â€” Káº¿ hoáº¡ch phÃ¡t triá»ƒn cÃ¡ nhÃ¢n', 40, 60);
              doc.setFontSize(11); doc.text('Thá»i gian: ' + new Date().toLocaleString(), 40, 84);
              let y = 110;
              goals.forEach(function(g, i){
                const line = (i+1)+'. ' + g.title + (g.when?(' â€” '+g.when):'') + (g.done?(' [ÄÃ£ xong]'):'');
                const wrapped = doc.splitTextToSize(line, 520);
                doc.text(wrapped, 40, y);
                y += (wrapped.length*14) + 8;
                if (y > 750) { doc.addPage(); y = 50; }
              });
              doc.save('futurepath-plan.pdf');
            } else {
              const blob = new Blob([JSON.stringify(goals, null, 2)], { type: 'application/json' });
              const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'futurepath-plan.json'; document.body.appendChild(a); a.click(); a.remove();
            }
          });
        }

        // initial render
        try { render(); } catch (e) { console.error(e); }
      })();

    </script>
  </body>
</html>

