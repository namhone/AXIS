          <section class="content-panel">
            <h2>02 Â· Lá»™ trÃ¬nh</h2>
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-badge">01</div>
                <div>
                  <strong>Há»c Python cÆ¡ báº£n</strong>
