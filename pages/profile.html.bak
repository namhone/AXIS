    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
      (function(){
        const authArea = document.getElementById('authArea');
        const userPanel = document.getElementById('userPanel');
        const userChip = document.getElementById('userChip');
        const userMenu = document.getElementById('userMenu');
        const menuButtons = document.querySelectorAll('[data-menu-action]');
        const authButtons = document.querySelectorAll('[data-auth-action]');
        const AUTH_KEY = 'futurepath.signed_in';

        const setSignedIn = (opts) => {
          // persist
          try { localStorage.setItem(AUTH_KEY, '1'); } catch (e) {}
          if (authArea) authArea.classList.add('hidden');
          if (userPanel) userPanel.classList.remove('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
          if (!opts || !opts.silent) {
            // small visual cue could be added here; keep minimal for demo
          }
        };

        const setSignedOut = (opts) => {
          try { localStorage.removeItem(AUTH_KEY); } catch (e) {}
          if (authArea) authArea.classList.remove('hidden');
          if (userPanel) userPanel.classList.add('hidden');
          if (userMenu) userMenu.classList.add('hidden');
          if (userChip) userChip.setAttribute('aria-expanded', 'false');
        };

        // wire demo auth buttons to persist state across pages
        authButtons.forEach(function (button) {
          button.addEventListener('click', function () { setSignedIn(); });
        });

        // apply persisted state on load
        try {
          if (localStorage.getItem(AUTH_KEY)) setSignedIn({ silent: true });
        } catch (e) {}


        if (userChip) {
          userChip.addEventListener('click', function () {
            if (!userMenu) return;
            const isHidden = userMenu.classList.contains('hidden');
            userMenu.classList.toggle('hidden', !isHidden);
            userChip.setAttribute('aria-expanded', String(isHidden));
          });
        }

        menuButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            const action = button.getAttribute('data-menu-action');
            if (action === 'settings') {
              const modal = document.getElementById('settingsModal');
              if (modal) modal.classList.remove('hidden');
            } else if (action === 'logout') {
              setSignedOut();
            } else {
              alert('TÃ­nh nÄƒng chÆ°a Ä‘Æ°á»£c triá»ƒn khai trong phiÃªn báº£n demo.');
            }
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded', 'false');
          });
        });

        const modal = document.getElementById('settingsModal');
        const closeModal = document.getElementById('closeSettingsModal');
        const saveSettings = document.getElementById('saveSettings');
        const closeTriggers = document.querySelectorAll('[data-close-settings="true"]');

        closeModal && closeModal.addEventListener('click', function () { modal && modal.classList.add('hidden'); });
        closeTriggers.forEach(function (trigger) { trigger.addEventListener('click', function () { modal && modal.classList.add('hidden'); }); });
        saveSettings && saveSettings.addEventListener('click', function () { alert('CÃ i Ä‘áº·t Ä‘Ã£ Ä‘Æ°á»£c lÆ°u thÃ nh cÃ´ng.'); modal && modal.classList.add('hidden'); });

        document.addEventListener('click', function (event) {
          if (!userMenu || !userChip) return;
          if (!userMenu.contains(event.target) && !userChip.contains(event.target)) {
            userMenu.classList.add('hidden');
            userChip.setAttribute('aria-expanded', 'false');
          }
        });
      })();

      (function(){
        // Header-nav is now the single source of truth. Attach safe click handlers to header nav items.
        const headerNav = document.querySelector('.header-nav');
        if (!headerNav) return;
        const navLinks = headerNav.querySelectorAll('.nav-item');

        navLinks.forEach(function (link) {
          link.addEventListener('click', function (e) {
            // Toggle active state
            navLinks.forEach(function (l){ l.classList.remove('active'); });
            link.classList.add('active');

            // Close user menu if open
            const userMenu = document.getElementById('userMenu');
            const userChip = document.getElementById('userChip');
            if (userMenu) userMenu.classList.add('hidden');
            if (userChip) userChip.setAttribute('aria-expanded','false');

          });
        });

        headerNav.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            const item = e.target.closest('.nav-item');
            if (item) { item.click(); e.preventDefault(); }
          }
        });
      })();

      const pdfUpload = document.getElementById('pdfUpload');
      const portraitUpload = document.getElementById('portraitUpload');
      const pdfPreview = document.getElementById('pdfPreview');
      const pdfEmptyState = document.getElementById('pdfEmptyState');
      const normalizeBtn = document.getElementById('aiNormalizeBtn');
      const exportBtn = document.getElementById('exportBtn');
      const examType = document.getElementById('examType');
      const provinceField = document.getElementById('provinceField');

      let currentPdfUrl = '';
      let normalizedPdfBlob = null;

      if (portraitUpload) {
        portraitUpload.addEventListener('change', function (event) {
          const file = event.target.files && event.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = function (e) {
            const preview = document.getElementById('portraitPreview');
            if (!preview) return;
            preview.innerHTML = '<img src="' + e.target.result + '" alt="áº¢nh chÃ¢n dung" />';
          };
          reader.readAsDataURL(file);
        });
      }

      if (examType) {
        examType.addEventListener('change', function () {
          const value = examType.value || '';
          const requiresProvince = value.includes('Tá»‰nh') || value.includes('ThÃ nh phá»‘') || value.includes('cáº¥p');
          if (provinceField) {
            provinceField.classList.toggle('hidden', !requiresProvince);
          }
        });
      }

      function showPdfPreview(url) {
        if (!url) return;
        currentPdfUrl = url;
        pdfPreview.src = url;
        pdfPreview.style.display = 'block';
        pdfEmptyState.style.display = 'none';
      }

      if (pdfUpload) {
        pdfUpload.addEventListener('change', function (event) {
          const file = event.target.files && event.target.files[0];
          if (!file) return;
          if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
            alert('Vui lÃ²ng chá»n file PDF há»£p lá»‡.');
            return;
          }
          if (currentPdfUrl) URL.revokeObjectURL(currentPdfUrl);
          showPdfPreview(URL.createObjectURL(file));
        });
      }

      if (normalizeBtn) {
        normalizeBtn.addEventListener('click', function () {
          const { jsPDF } = window.jspdf;
          const doc = new jsPDF({ unit: 'pt', format: 'a4' });
          const pageWidth = doc.internal.pageSize.getWidth();

          doc.setFillColor(245, 241, 255);
          doc.rect(0, 0, pageWidth, 842, 'F');
          doc.setTextColor(58, 43, 96);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(20);
          doc.text('FuturePath â€” Há»“ sÆ¡ nÄƒng lá»±c Ä‘Ã£ chuáº©n hÃ³a', 40, 60);

          doc.setFontSize(12);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(73, 67, 109);
          const lines = [
            'TÃªn: Nguyá»…n Minh Anh',
            'Lá»›p: 10',
            'Má»¥c tiÃªu nghá» nghiá»‡p: KhÃ¡m phÃ¡ nhÃ³m ngÃ nh CÃ´ng nghá»‡, táº­p trung vÃ o phÃ¡t triá»ƒn ká»¹ nÄƒng phÃ¢n tÃ­ch vÃ  giáº£i quyáº¿t váº¥n Ä‘á».',
            'Äiá»ƒm máº¡nh: tÆ° duy logic, sÃ¡ng táº¡o, kháº£ nÄƒng há»c táº­p nhanh, tinh tháº§n ham há»c há»i.',
            'Ká»¹ nÄƒng: ká»¹ nÄƒng trÃ¬nh bÃ y, tá»• chá»©c thá»i gian, lÃ m viá»‡c nhÃ³m vÃ  sá»­ dá»¥ng cÃ´ng cá»¥ cÃ´ng nghá»‡ cÆ¡ báº£n.',
            'Khuyáº¿n nghá»‹: tiáº¿p tá»¥c phÃ¡t triá»ƒn ká»¹ nÄƒng tiáº¿ng Anh, láº­p trÃ¬nh cÆ¡ báº£n vÃ  ká»¹ nÄƒng thuyáº¿t trÃ¬nh Ä‘á»ƒ tÄƒng cÆ¡ há»™i phÃ¹ há»£p vá»›i cÃ¡c ngÃ nh nhÆ° Khoa há»c dá»¯ liá»‡u, Ká»¹ thuáº­t pháº§n má»m, UI/UX.',
            'TÃ³m táº¯t: Há»“ sÆ¡ nÃ y Ä‘Ã£ Ä‘Æ°á»£c sáº¯p xáº¿p theo hÆ°á»›ng chuyÃªn nghiá»‡p, rÃµ má»¥c tiÃªu, dá»… Ä‘á»c vÃ  phÃ¹ há»£p vá»›i Ä‘Ã¡nh giÃ¡ nghá» nghiá»‡p trong tÆ°Æ¡ng lai.'
          ];

          let y = 100;
          lines.forEach((line) => {
            const wrapped = doc.splitTextToSize(line, pageWidth - 80);
            doc.text(wrapped, 40, y);
            y += wrapped.length * 18 + 10;
            if (y > 760) {
              doc.addPage();
              y = 50;
            }
          });

          normalizedPdfBlob = doc.output('blob');
          if (currentPdfUrl) URL.revokeObjectURL(currentPdfUrl);
          showPdfPreview(URL.createObjectURL(normalizedPdfBlob));
        });
      }

      if (exportBtn) {
        exportBtn.addEventListener('click', function () {
          const blobToDownload = normalizedPdfBlob || (pdfUpload && pdfUpload.files && pdfUpload.files[0] ? new Blob([pdfUpload.files[0]], { type: 'application/pdf' }) : null);
          if (!blobToDownload) {
            alert('Báº¡n cáº§n chá»n hoáº·c táº¡o file PDF trÆ°á»›c khi xuáº¥t.');
            return;
          }

          const link = document.createElement('a');
          const url = URL.createObjectURL(blobToDownload);
          link.href = url;
          link.download = 'futurepath-profile.pdf';
          document.body.appendChild(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(url);
          alert('File PDF Ä‘Ã£ Ä‘Æ°á»£c xuáº¥t thÃ nh cÃ´ng.');
        });
      }
    </script>
  </body>
</html>

