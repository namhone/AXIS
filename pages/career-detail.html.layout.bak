<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Chi tiết nghề nghiệp — FuturePath</title>
  <link rel="stylesheet" href="../css/global.css">
</head>
<body class="has-search">
  <div class="page-shell">
    

    <main class="workspace">
      <header class="topbar">
        <div class="header-brand">
          <a class="brand-link" href="../index.html">
            <div class="brand">
              <div class="brand-mark" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-mark-inner-svg" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="4" fill="currentColor" />
                  <path d="M7 12h10M12 7v10" stroke="rgba(255,255,255,0.9)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="brand-copy"><span>FuturePath</span><small>Hướng nghiệp</small></div>
            </div>
          </a>
        </div>

        <nav class="header-nav" role="navigation" aria-label="Chính">
          <a class="nav-item active" href="career-detail.html"><span class="nav-ico">▣</span><span>Chi tiết nghề</span></a>
          <a class="nav-item" href="careers.html"><span class="nav-ico">▤</span><span>Khám phá</span></a>
        </nav>

        <div class="header-auth">
          <div class="auth-area" id="authArea">
            <button class="auth-btn ghost-btn" type="button" data-auth-action="signin">Đăng nhập</button>
            <button class="auth-btn primary-btn" type="button" data-auth-action="signup">Đăng ký</button>
          </div>
        </div>
      </header>

      <section class="content-grid">
        <article class="main-column">
          <div class="panel-heading">
            <h3>Chi tiết: Data Scientist</h3>
            <a href="#">Lưu</a>
          </div>

          <div class="tool-card">
            <h3>Tổng quan</h3>
            <p>Data Scientist là người chuyển dữ liệu thô thành insight, sử dụng thống kê, máy học và trực quan hoá để giải quyết vấn đề kinh doanh.</p>

            <div class="panel-heading" style="margin-top:16px">
              <h3>Kỹ năng chính</h3>
            </div>
            <div class="skill-row">
              <small class="skill-pill pill-indigo">Python</small>
              <small class="skill-pill pill-indigo">Machine Learning</small>
              <small class="skill-pill pill-teal">Statistics</small>
            </div>

            <div style="margin-top:18px">
              <h4>Mô tả công việc</h4>
              <p class="summary-body">Phân tích dữ liệu, xây dựng mô hình, làm việc chặt với product và stakeholders để đưa ra quyết định dựa trên dữ liệu.</p>
            </div>
          </div>
        </article>

        <aside class="side-column">
          <div class="mini-panel">
            <div class="panel-heading"><h3>Lộ trình nghề</h3></div>
            <div class="summary-list">
              <div class="summary-item">Học Python</div>
              <div class="summary-item">Học thống kê</div>
              <div class="summary-item">Thực hành dự án</div>
            </div>
          </div>

          <div class="mini-panel">
            <div class="panel-heading"><h3>Mức lương tham khảo</h3></div>
            <div class="score-row"><div class="score-tag">VN</div><div class="score-value">10-25M</div></div>
          </div>
        </aside>
      </section>

      <footer class="site-footer">© FuturePath</footer>
    </main>
  </div>
<script>
(function(){
  // Build mobile menu UI once
  const header = document.querySelector('.topbar');
  if (!header) return;
  if (document.querySelector('.mobile-menu-button')) return; // already added

  const headerAuth = header.querySelector('.header-auth');
  const headerNav = header.querySelector('.header-nav');

  // Create button
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'mobile-menu-button';
  btn.setAttribute('aria-expanded', 'false');
  btn.setAttribute('aria-label', 'Mở menu');
  btn.innerHTML = '☰';

  // Insert button before auth (so it's between nav area and auth)
  if (headerAuth && headerAuth.parentNode) {
    header.insertBefore(btn, headerAuth);
  } else {
    header.appendChild(btn);
  }

  // Create overlay and clone nav into it
  const overlay = document.createElement('div');
  overlay.className = 'mobile-nav-overlay hidden';
  const mobileNav = document.createElement('nav');
  mobileNav.className = 'mobile-nav';

  if (headerNav) {
    // clone nav items
    headerNav.querySelectorAll('.nav-item').forEach(function(item){
      const clone = item.cloneNode(true);
      // ensure spacing and block behavior
      clone.addEventListener('click', function(){ overlay.classList.add('hidden'); document.body.classList.remove('mobile-nav-open'); btn.setAttribute('aria-expanded','false'); });
      mobileNav.appendChild(clone);
    });
  } else {
    // fallback: build basic links
    const links = [ ['Hồ sơ năng lực','/pages/profile.html'], ['Đánh giá & Gợi ý','/pages/assessment.html'], ['Phát triển bản thân','/pages/development.html'], ['Thư viện nghề nghiệp','/pages/careers.html'], ['Về dự án','/pages/about.html'] ];
    links.forEach(function(l){ const a = document.createElement('a'); a.className='nav-item'; a.href=l[1]; a.textContent=l[0]; a.addEventListener('click', function(){ overlay.classList.add('hidden'); document.body.classList.remove('mobile-nav-open'); btn.setAttribute('aria-expanded','false'); }); mobileNav.appendChild(a); });
  }

  overlay.appendChild(mobileNav);
  document.body.appendChild(overlay);

  // Toggle handler
  btn.addEventListener('click', function(e){
    const open = !overlay.classList.contains('hidden');
    if (open) {
      overlay.classList.add('hidden');
      document.body.classList.remove('mobile-nav-open');
      btn.setAttribute('aria-expanded','false');
    } else {
      overlay.classList.remove('hidden');
      document.body.classList.add('mobile-nav-open');
      btn.setAttribute('aria-expanded','true');
    }
  });

  // Close overlay on backdrop click
  overlay.addEventListener('click', function(e){ if (e.target === overlay) { overlay.classList.add('hidden'); document.body.classList.remove('mobile-nav-open'); btn.setAttribute('aria-expanded','false'); } });

  // Close on Escape
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') { overlay.classList.add('hidden'); document.body.classList.remove('mobile-nav-open'); btn.setAttribute('aria-expanded','false'); } });
})();
</script>
</body>
</html>



