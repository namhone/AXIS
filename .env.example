# Copy to .env for package-style runs from FuturePath.
# See backend/.env.example for setup notes.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/futurepath
ENVIRONMENT=development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_NAME=futurepath_access_token
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
GROQ_API_KEY=your_groq_api_key_here
