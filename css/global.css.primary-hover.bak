@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap');

:root {`r`n  --transition-menu: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  --bg: #f6f7f9;
  --panel: #ffffff;
  --panel-soft: #f4f6f8;
  --purple: #0b3d66; /* kept name for compatibility, now deep steel-blue */
  --purple-deep: #061d33; /* deeper accent */
  --purple-soft: #eef6ff;
  --pink: #c5d8ea; /* subtle cool highlight */
  --mint: #eaf6f8;
  --mint-deep: #77c0cd;
  --cream: #fffdfc;
  --line: #e6e9ee;
  --text: #0b1220;
  --text-soft: #5b6770;
  --success: #0f9d58;
  --shadow: rgba(3,18,30,0.06);
  --accent-rgb: 11,61,102; /* for rgba() usages */
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
 margin: 0;
 font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
 background: var(--bg);
 color: var(--text);
}

a { color: inherit; text-decoration: none; }
button, input {
 font: inherit;
}

.page-shell {
 display: flex;
 gap: 22px;
 min-height: 100vh;
 padding: 18px 18px 20px 18px;
}

.sidebar {
 width: 240px;
 background: rgba(255, 255, 255, 0.64);
 backdrop-filter: blur(12px);
 border: 1px solid rgba(140, 128, 201, 0.16);
 border-radius: 28px;
 padding: 18px 14px 16px;
 box-shadow: 0 18px 35px var(--shadow);
 display: flex;
 flex-direction: column;
}

.brand {
 display: flex;
 align-items: center;
 gap: 12px;
 padding: 4px 8px 24px;
 margin-right: auto;
}

.brand-mark {
 width: 34px;
 height: 34px;
 border-radius: 10px;
 background: var(--panel);
 border: 1px solid var(--line);
 display: grid;
 place-items: center;
 transform: rotate(45deg);
 box-shadow: 0 6px 14px var(--shadow);
 color: var(--purple);
}
.brand-mark-inner-svg { width: 18px; height: 18px; transform: rotate(-45deg); display:block; }
.brand-link { text-decoration: none; color: inherit; display:inline-flex; align-items:center; }
.sidebar-auth { margin-left: auto; display:flex; align-items:center; }
.sidebar-auth .auth-area { display:flex; gap:8px; }
.brand-mark-inner {
 width: 18px;
 height: 18px;
 border-radius: 7px;
 background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(255,255,255,0.3));
}

.brand-copy {
 display: flex;
 flex-direction: column;
 line-height: 1.1;
}

.brand-copy span {
 font-size: 24px;
 font-weight: 900;
 letter-spacing: -0.06em;
 color: var(--purple-deep);
}

.brand-copy small {
 font-size: 10px;
 color: var(--text-soft);
 letter-spacing: 0.02em;
}

.nav {
 display: grid;
 gap: 8px;
 margin-top: 8px;
}

.nav-item {
 display: flex;
 align-items: center;
 gap: 12px;
 min-height: 48px;
 padding: 12px 14px;
 border-radius: 14px;
 font-weight: 700;
 color: var(--text-soft);
 transition: 0.22s ease;
 white-space: nowrap;
}

.nav-item:hover {
 background: rgba(var(--accent-rgb), 0.06);
 color: var(--purple-deep);
}

.nav-item.active {
 color: #fff;
 background: var(--purple);
 box-shadow: 0 8px 20px var(--shadow);
}

.nav-ico {
 display: inline-grid;
 place-items: center;
 width: 18px;
 font-size: 18px;
}

.sidebar-quote {
 margin-top: auto;
 padding: 18px 8px 6px;
 border-top: 1px solid var(--line);
}

.sidebar-quote p {
 margin: 0;
 font-size: 18px;
 line-height: 1.45;
 font-weight: 700;
 letter-spacing: -0.03em;
 color: var(--purple-deep);
 font-style: italic;
}

.workspace {
 flex: 1;
 min-width: 0;
}

.topbar {
 display: flex;
 align-items: center;
 gap: 18px;
 padding: 12px 24px;
 background: transparent;
 position: sticky;
 top: 12px;
 z-index: 50;
}
.header-brand { display:flex; align-items:center; gap:12px; flex:0 0 auto; }
.header-nav { display:flex; gap:10px; flex:1 1 auto; justify-content:center; white-space:nowrap; overflow-x:auto; -webkit-overflow-scrolling:touch; padding:6px 20px; }
.header-nav::-webkit-scrollbar{ display:none; }
.header-nav .nav-item { display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border-radius:8px; color:var(--text-soft); font-weight:700; transition:0.18s; flex:0 0 auto; white-space: nowrap; flex-shrink: 0; }
.header-nav .nav-item:hover{ background: rgba(var(--accent-rgb),0.04); color:var(--purple-deep); }
.header-nav .nav-item.active { background: var(--purple); color: #fff; box-shadow: 0 8px 20px var(--shadow); }
.header-auth { margin-left:auto; display:flex; align-items:center; gap:8px; flex:0 0 auto; }

@media (max-width: 980px){ .header-nav{ justify-content:flex-start; } }
@media (max-width: 720px){ .header-nav .nav-item span:not(.nav-ico){ display:none; } .search-box{ display:none; } }

.search-box {
 flex: 1;
 display: flex;
 align-items: center;
 gap: 12px;
 min-width: 220px;
 height: 54px;
 padding: 0 18px;
 border-radius: 18px;
 background: rgba(255, 255, 255, 0.84);
 border: 1px solid rgba(140, 128, 201, 0.12);
 box-shadow: 0 8px 18px rgba(92, 79, 160, 0.06);
}

.search-icon {
 font-size: 24px;
 color: var(--purple);
 opacity: 0.8;
}

.search-box input {
 flex: 1;
 border: 0;
 outline: none;
 background: transparent;
 font-size: 16px;
 color: var(--text-soft);
}

.topbar-tools {
 display: flex;
 align-items: center;
 gap: 14px;
}

.account-shell {
 position: relative;
 display: flex;
 align-items: center;
}

.auth-area {
 display: flex;
 align-items: center;
 gap: 10px;
}

.auth-btn {
  height: 36px;
  padding: 0 12px;
  border-radius: 8px;
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  font-weight: 700;
  cursor: pointer;
  background: transparent;
  white-space: nowrap;
}

.auth-btn-primary {
  background: var(--purple);
  color: #fff;
  box-shadow: 0 8px 18px var(--shadow);
}

.auth-btn-secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.icon-button {
 width: 40px;
 height: 40px;
 border: 1px solid rgba(var(--accent-rgb), 0.12);
 border-radius: 12px;
 background: rgba(255,255,255,0.7);
 font-size: 22px;
 color: var(--purple-deep);
}

.user-panel {
 position: relative;
}

.user-chip {
 display: flex;
 align-items: center;
 gap: 10px;
 min-width: 170px;
 padding: 6px 10px 6px 6px;
 border-radius: 18px;
 background: rgba(255,255,255,0.7);
 border: 1px solid rgba(140, 128, 201, 0.12);
 cursor: pointer;
 color: inherit;
}

.user-avatar {
 width: 38px;
 height: 38px;
 border-radius: 50%;
 background: linear-gradient(135deg, rgba(var(--accent-rgb),0.06), rgba(255,255,255,0.6));
 display: grid;
 place-items: center;
 font-weight: 800;
 color: var(--purple-deep);
}

.user-text {
 display: flex;
 flex-direction: column;
 min-width: 0;
 text-align: left;
}

.user-text strong {
 font-size: 14px;
 line-height: 1.2;
}

.user-text small {

 color: var(--text-soft);
 font-size: 11px;
}

.caret {
 color: var(--text-soft);
 margin-left: auto;
 font-size: 18px;
}

.hidden {
 display: none !important;
}

.user-menu {
 position: absolute;
 top: calc(100% + 10px);
 right: 0;
 min-width: 220px;
 display: grid;
 gap: 6px;
 padding: 10px;
 border-radius: 18px;
 background: rgba(255,255,255,0.96);
 border: 1px solid rgba(140, 128, 201, 0.14);
 box-shadow: 0 18px 36px rgba(64, 46, 128, 0.12);
 z-index: 20;
}

.user-menu-item {
 width: 100%;
 border: 0;
 background: transparent;
 border-radius: 12px;
 padding: 10px 12px;
 text-align: left;
 font-weight: 700;
 color: var(--text);
 cursor: pointer;
}

.user-menu-item:hover {
 background: rgba(108, 92, 231, 0.06);
 color: var(--purple-deep);
}

.user-menu-item.logout {
 color: #c43d76;
}

.settings-modal {
 position: fixed;
 inset: 0;
 display: grid;
 place-items: center;
 z-index: 80;
}

.settings-modal-backdrop {
 position: absolute;
 inset: 0;
 background: rgba(32, 26, 62, 0.26);
}

.settings-panel {
 position: relative;
 width: min(480px, calc(100vw - 32px));
 background: rgba(255,255,255,0.98);
 border: 1px solid rgba(140, 128, 201, 0.14);
 border-radius: 24px;
 box-shadow: 0 26px 50px rgba(58, 39, 109, 0.18);
 padding: 20px;
}

.settings-header {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 margin-bottom: 16px;
}

.settings-header h3 {
 margin: 0;
 color: var(--purple-deep);
}

.settings-close {
 width: 34px;
 height: 34px;
 border: 0;
 border-radius: 10px;
 background: rgba(var(--accent-rgb), 0.06);
 color: var(--purple-deep);
 font-size: 24px;
 cursor: pointer;
}

.settings-list {
 display: grid;
 gap: 12px;
}

.setting-item {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 padding: 12px 14px;
 border-radius: 14px;
 background: rgba(108, 92, 231, 0.04);
 color: var(--text);
 font-weight: 700;
}

.setting-item input {
 accent-color: var(--purple);
 width: 18px;
 height: 18px;
}

.settings-actions {
 display: flex;
 justify-content: flex-end;
 gap: 10px;
 margin-top: 20px;
}

.content-grid {
 display: grid;
 grid-template-columns: minmax(0, 2.18fr) minmax(290px, 0.82fr);
 gap: 18px;
 align-items: start;
}

.main-column,
.side-column {
 display: grid;
 gap: 18px;
}

.hero-card {
 position: relative;
 display: grid;
 grid-template-columns: 1.1fr 0.9fr;
 gap: 8px;
 min-height: 336px;
 padding: 28px 28px 18px 28px;
 border-radius: 30px;
 background: linear-gradient(135deg, var(--panel-soft) 0%, var(--panel) 42%, var(--panel) 100%);
 border: 1px solid rgba(var(--accent-rgb), 0.06);
 box-shadow: 0 18px 32px rgba(var(--accent-rgb), 0.06);
 overflow: hidden;
}

.hero-card::before {
 content: "";
 position: absolute;
 inset: 0;
 background: radial-gradient(circle at 15% 18%, rgba(255,255,255,0.72), transparent 32%);
}

.hero-copy,
.hero-visual {
 position: relative;
 z-index: 1;
}

.hero-copy {
 padding: 18px 8px 4px 6px;
}

.hero-copy h1 {
 margin: 0;
 font-size: clamp(2.2rem, 3vw, 3.35rem);
 line-height: 1.08;
 letter-spacing: -0.05em;
 color: var(--purple-deep);
}

.hero-copy h1 span {
 color: var(--purple);
}

.hero-copy p {
 margin-top: 18px;
 max-width: 530px;
 font-size: 1.08rem;
 line-height: 1.7;
 color: var(--text-soft);
}

.hero-actions {
 display: flex;
 flex-wrap: wrap;
 gap: 14px;
 margin-top: 26px;
}

a.primary-btn,
a.ghost-btn,
.primary-btn,
.ghost-btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 border: 0;
 border-radius: 12px;
 height: 46px;
 padding: 0 20px;
 font-weight: 700;
 cursor: pointer;
 text-decoration: none;
 line-height: 1;
 transition: transform 160ms ease, box-shadow 180ms ease, background-color 160ms ease, color 160ms ease;
}
 
.primary-btn {
 background: var(--purple);
 color: #fff;
 box-shadow: 0 8px 18px var(--shadow);
}
 
.ghost-btn {
 background: transparent;
 color: var(--text);
 border: 1px solid var(--line);
}

.hero-visual {
 display: flex;
 align-items: flex-end;
 justify-content: center;
 padding-top: 12px;
}

.hero-illustration {
 display: block;
 width: 100%;
 max-width: 520px;
 height: auto;
 object-fit: contain;
 filter: drop-shadow(0 14px 20px rgba(102, 90, 195, 0.08));
}

.tools-section {
 background: rgba(255, 255, 255, 0.2);
 border-radius: 28px;
 padding: 10px 0 0;
}

.tools-section h2,
.radar-panel h2 {
 margin: 0 0 18px;
 font-size: clamp(1.8rem, 1.8vw, 2.2rem);
 letter-spacing: -0.04em;
 color: var(--purple-deep);
}

.tool-grid {
 display: grid;
 grid-template-columns: repeat(4, minmax(0, 1fr));
 gap: 16px;
}

.tool-card {
 position: relative;
 min-height: 210px;
 padding: 20px 18px 16px;
 border-radius: 22px;
 border: 1px solid var(--line);
 background: rgba(255,255,255,0.86);
 display: flex;
 flex-direction: column;
 box-shadow: 0 10px 20px rgba(114, 74, 182, 0.04);
}

.tool-card h3 {
 margin: 0 0 8px;
 font-size: 1.04rem;
 line-height: 1.3;
 color: var(--text);
}

.tool-card p {
 margin: 0;
 color: var(--text-soft);
 font-size: 0.96rem;
 line-height: 1.55;
}

.tool-icon {
 width: 54px;
 height: 54px;
 display: grid;
 place-items: center;
 margin-bottom: 18px;
 border-radius: 16px;
 font-size: 1.8rem;
 font-weight: 700;
 background: rgba(255,255,255,0.48);
}

.accent-1 { background: var(--panel-soft); }
.accent-2 { background: var(--cream); }
.accent-3 { background: var(--mint); }
.accent-4 { background: var(--panel-soft); }

.accent-1 .tool-icon { background: rgba(var(--accent-rgb), 0.08); color: var(--purple); }
.accent-2 .tool-icon { background: rgba(var(--accent-rgb), 0.04); color: var(--text); }
.accent-3 .tool-icon { background: rgba(var(--accent-rgb), 0.04); color: var(--success); }
.accent-4 .tool-icon { background: rgba(var(--accent-rgb), 0.06); color: var(--purple-deep); }

.tool-arrow {
 margin-top: auto;
 align-self: flex-end;
 width: 36px;
 height: 36px;
 border-radius: 50%;
 display: grid;
 place-items: center;
 background: rgba(255,255,255,0.7);
 color: var(--purple-deep);
 font-weight: 800;
}

.radar-panel {
 background: rgba(255,255,255,0.18);
 border-radius: 28px;
 padding: 8px 0 0;
}

.radar-layout {
 display: grid;
 grid-template-columns: minmax(0, 1.14fr) minmax(0, 0.86fr);
 gap: 20px;
 align-items: stretch;
}

.radar-wrap {
 display: flex;
 align-items: center;
 justify-content: center;
 min-height: 260px;
 padding: 14px 12px;
 border-radius: 24px;
 background: rgba(255,255,255,0.4);
 border: 1px solid rgba(122, 101, 219, 0.1);
}

.radar-image {
 display: block;
 width: 100%;
 max-width: 340px;
 height: auto;
 object-fit: contain;
}

.chart-labels text {
 fill: var(--text-soft);
 font-size: 12px;
 font-weight: 700;
}

.chart-summary {
 display: flex;
 flex-direction: column;
 gap: 16px;
}

.score-box {
 display: grid;
 gap: 12px;
 padding: 18px 18px 14px;
 border-radius: 20px;
 background: rgba(255,255,255,0.4);
 border: 1px solid rgba(122, 101, 219, 0.1);
}

.score-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 padding: 8px 0;
 border-bottom: 1px solid rgba(var(--accent-rgb), 0.06);
}

.score-row:last-child {
 border-bottom: none;
}

.score-tag {
 color: var(--text-soft);
 font-weight: 700;
}

.score-value {
 color: var(--purple-deep);
 font-weight: 800;
 font-size: 1.05rem;
}

.summary-list {
 display: grid;
 gap: 8px;
 padding: 14px 6px 0;
}

.summary-item {
 display: flex;
 align-items: center;
 gap: 12px;
 padding: 10px 12px;
 border-radius: 12px;
 color: var(--text-soft);
 font-weight: 700;
}

.summary-item.active {
 background: rgba(var(--accent-rgb), 0.08);
 color: var(--purple-deep);
}

.check {
 width: 22px;
 height: 22px;
 display: inline-grid;
 place-items: center;
 border-radius: 50%;
 background: var(--success);
 color: #fff;
 font-size: 12px;
 font-weight: 900;
}

.mini-panel {
 background: rgba(255,255,255,0.72);
 border: 1px solid rgba(122, 101, 219, 0.12);
 border-radius: 26px;
 padding: 18px 18px 16px;
 box-shadow: 0 12px 24px rgba(106, 88, 188, 0.05);
}

.panel-heading {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 margin-bottom: 18px;
}

.panel-heading h3 {
 margin: 0;
 font-size: clamp(1.3rem, 1.4vw, 1.6rem);
 letter-spacing: -0.04em;
 color: var(--purple-deep);
}

.panel-heading a {
 color: var(--purple);
 font-size: 0.9rem;
 font-weight: 700;
}

.score-circular {
 display: flex;
 justify-content: center;
 margin: 4px 0 18px;
}

.ring {
 position: relative;
 width: 150px;
 height: 150px;
 border-radius: 50%;
 background: conic-gradient(var(--purple) 0 78%, var(--panel-soft) 78% 100%);
 display: grid;
 place-items: center;
}

.ring::before {
 content: "";
 position: absolute;
 inset: 12px;
 border-radius: 50%;
 background: rgba(255,255,255,0.9);
}

.ring-inner {
 position: relative;
 z-index: 1;
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 2px;
}

.ring-inner strong {
 font-size: 2.2rem;
 letter-spacing: -0.05em;
 color: var(--purple-deep);
}

.ring-inner span {
 font-size: 0.76rem;
 color: var(--text-soft);
 text-align: center;
}

.checklist,
.roadmap-list {
 list-style: none;
 padding: 0;
 margin: 0;
 display: grid;
 gap: 12px;
}

.checklist li,
.roadmap-list li {
 position: relative;
 padding-left: 28px;
 font-weight: 700;
 color: var(--text-soft);
 line-height: 1.4;
}

.checklist li::before,
.roadmap-list li::before {
 content: "";
 position: absolute;
 left: 0;
 top: 2px;
 width: 18px;
 height: 18px;
 border-radius: 50%;
 background: rgba(108, 92, 231, 0.08);
}

.checklist li.done::before,
.roadmap-list li.done::before {
 content: "✓";
 display: grid;
 place-items: center;
 font-size: 11px;
 color: #fff;
 background: var(--success);
 font-weight: 900;
}

.checklist li.done,
.roadmap-list li.done {
 color: var(--text);
}

.roadmap-list li.pending::before {
 content: "○";
 display: grid;
 place-items: center;
 font-size: 10px;
 color: var(--purple-deep);
 background: rgba(var(--accent-rgb), 0.12);
}

.full {
 width: 100%;
 margin-top: 18px;
}

.career-item {
 margin-top: 10px;
 padding-top: 8px;
}

.career-topline {
 display: flex;
 align-items: center;
 gap: 12px;
 margin-bottom: 10px;
 font-weight: 700;
 color: var(--text);
}

.career-icon {
 width: 32px;
 height: 32px;
 border-radius: 10px;
 display: grid;
 place-items: center;
 font-size: 16px;
 color: var(--purple-deep);
}

.icon-lavender { background: var(--panel-soft); }
.icon-teal { background: var(--mint); }
.icon-soft { background: var(--panel-soft); }

.progress-track {
 height: 10px;
 border-radius: 999px;
 background: var(--panel-soft);
 overflow: hidden;
}

.progress-track span {
 display: block;
 height: 100%;
 border-radius: inherit;
 background: linear-gradient(90deg, var(--purple), var(--purple-deep));
}

.career-item small {
 display: inline-block;
 margin-top: 8px;
 color: var(--text-soft);
 font-weight: 700;
}

/* Layout caps and general responsive tuning */
.page-shell {
 max-width: 1400px;
 margin: 0 auto;
}

@media (max-width: 1180px) {
 .content-grid {
   grid-template-columns: 1fr;
 }

 .side-column {
   grid-template-columns: repeat(3, minmax(0, 1fr));
 }

 .hero-illustration {
   max-height: 360px;
 }
}

@media (min-width: 981px) {
 /* Header-as-top navigation when wide enough */
 .page-shell {
   display: block;
 }

 .sidebar {
   width: 100%;
   flex-direction: row;
   align-items: center;
   justify-content: space-between;
   gap: 18px;
   padding: 14px 18px;
   border-radius: 22px;
 }

 .brand {
   padding: 0;
   flex-shrink: 0;
 }

 .nav {
   display: flex;
   flex: 1;
   gap: 8px;
   align-items: center;
   justify-content: flex-end;
   overflow-x: auto;
   scrollbar-width: none;
   -ms-overflow-style: none;
   white-space: nowrap;
 }

 .nav::-webkit-scrollbar { display: none; }

 .nav-item {
   min-width: max-content;
   padding: 11px 14px;
   flex-shrink: 0;
 }

 .sidebar-quote { display: none; }
}

.nav-toggle {
 display: none;
 width: 46px;
 height: 46px;
 border: 1px solid rgba(var(--accent-rgb), 0.18);
 border-radius: 12px;
 background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(238,232,255,0.9));
 align-items: center;
 justify-content: center;
 flex-direction: column;
 gap: 5px;
 cursor: pointer;
 padding: 0;
 box-shadow: 0 10px 18px rgba(var(--accent-rgb), 0.08);
}

.nav-toggle span {
 display: block;
 width: 22px;
 height: 3px;
 border-radius: 999px;
 background: var(--purple-deep);
 transition: transform 0.22s ease, opacity 0.22s ease;
}

.nav-toggle.is-open span:nth-child(1) {
 transform: translateY(8px) rotate(45deg);
}

.nav-toggle.is-open span:nth-child(2) {
 opacity: 0;
}

.nav-toggle.is-open span:nth-child(3) {
 transform: translateY(-8px) rotate(-45deg);
}

@media (max-width: 1200px) {
 .sidebar {
   gap: 10px;
   padding: 12px 10px;
 }

 .brand-copy span {
   font-size: 20px;
 }

 .brand-copy small {
   display: none;
 }

 .nav {
   gap: 6px;
   justify-content: flex-end;
 }

 .nav-item {
   min-width: 42px;
   padding: 10px 10px;
   justify-content: center;
 }

 .nav-item span:last-child {
   display: none;
 }
}

@media (max-width: 980px) {
 .page-shell { flex-direction: column; }

 .sidebar {
   width: 100%;
   display: flex;
   flex-direction: column;
   align-items: stretch;
   gap: 12px;
   padding: 12px 14px;
   border-radius: 20px;
   overflow: hidden;
 }

 .sidebar-bar {
   display: flex;
   align-items: center;
   justify-content: space-between;
   gap: 12px;
   width: 100%;
 }

 .brand {
   padding: 0;
   flex-shrink: 0;
   margin-right: auto;
 }

 .nav-toggle {
   display: inline-flex;
   margin-left: auto;
 }

 .nav {
   display: none;
   width: 100%;
   gap: 8px;
   margin-top: 6px;
   padding-top: 6px;
   border-top: 1px solid var(--line);
 }

 .sidebar[data-nav-open="true"] .nav {
   display: grid;
 }

 .sidebar[data-nav-open="false"] .nav {
   display: none;
 }

 .nav-item {
   width: 100%;
   justify-content: flex-start;
   min-width: 0;
   padding: 12px 14px;
 }

 .nav-item span:last-child { display: inline; }

 .sidebar-quote { display: none; }

 .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

 .hero-illustration { max-height: 300px; }
}

@media (max-width: 720px) {
 .sidebar { padding: 10px 12px; }
}

@media (max-width: 640px) {
 /* Mobile focused tweaks */
 .page-shell { padding: 12px; }

 .sidebar { flex-wrap: nowrap; overflow: hidden; }

 /* Make topbar stack and compact on mobile */
 .topbar { flex-direction: column; align-items: stretch; }
 .search-box { width: 100%; }
 .topbar-tools { justify-content: space-between; }

 /* Hero reduces vertically and buttons stack */
 .hero-card { grid-template-columns: 1fr; padding: 18px 14px; min-height: auto; }
 .hero-illustration { max-height: 220px; width: 100%; }
 .hero-copy h1 { font-size: clamp(1.35rem, 4.6vw, 2rem); }
 .hero-copy p { font-size: 0.98rem; max-width: 100%; }
 .hero-actions { flex-direction: column; gap: 12px; }
 .primary-btn, .ghost-btn { width: 100%; }

 /* Cards and panels become single column and shrink padding */
 .tool-grid, .radar-layout, .side-column { grid-template-columns: 1fr; }
 .tool-card { min-height: auto; padding: 14px; }
 .mini-panel { padding: 12px; }

 /* Avoid horizontal overflow */
 html, body { overflow-x: hidden; }
}

/* Extra small screens: ensure no overflowing images / text */
@media (max-width: 420px) {
 .hero-illustration { max-height: 180px; }
 .nav-item { padding: 8px; }
 .search-box { height: 48px; }
 .user-text strong { font-size: 13px; }
}

/* Utility to prevent long text causing layout shifts */
* { max-width: 100%; }

.team-grid,
.guide-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.team-card,
.guide-card,
.feature-card {
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(var(--accent-rgb), 0.06);
  border-radius: 22px;
  padding: 18px;
  box-shadow: 0 12px 24px rgba(var(--accent-rgb), 0.04);
}

.team-card h3,
.guide-card h3,
.feature-card h3 {
  margin: 0 0 8px;
  color: var(--purple-deep);
}

.step-list {
  display: grid;
  gap: 12px;
  margin-top: 18px;
}

.step-item {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(var(--accent-rgb), 0.06);
  color: var(--text-soft);
  font-weight: 700;
}

.step-number {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--purple);
  color: #fff;
  font-size: 0.76rem;
}

.profile-workspace {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 18px;
  align-items: start;
}

.subsection-stack {
  display: grid;
  gap: 18px;
  margin-top: 18px;
}

.profile-header {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.7fr);
  gap: 18px;
  margin-bottom: 12px;
  align-items: start;
}

.portrait-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 18px 14px 16px;
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.04), rgba(255, 255, 255, 0.72));
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  box-shadow: 0 12px 24px rgba(var(--accent-rgb), 0.06);
  max-width: 240px;
  width: 100%;
  justify-self: end;
  overflow: hidden;
}

.portrait-upload label {
  color: var(--purple-deep);
  font-weight: 800;
  font-size: 0.9rem;
  text-align: center;
}

.portrait-upload input[type="file"] {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.portrait-preview {
  width: 140px;
  height: 140px;
  border-radius: 24px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.12), rgba(255, 184, 107, 0.06));
  color: var(--purple-deep);
  font-weight: 800;
  font-size: 2.6rem;
  overflow: hidden;
  border: 1px solid rgba(var(--accent-rgb), 0.08);
}

.portrait-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.portrait-upload label[for="portraitUpload"].primary-btn {
  width: 100%;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  margin-top: 4px;
  min-height: 42px;
  border-radius: 12px;
  color: #ffffff !important;
  background: linear-gradient(90deg, var(--purple), var(--purple-deep)) !important;
  box-shadow: 0 12px 22px rgba(var(--accent-rgb), 0.12);
}

.mini-form {
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(122, 101, 219, 0.12);
  border-radius: 20px;
  padding: 18px;
}

.mini-form h3 {
  margin: 0 0 12px;
  color: var(--purple-deep);
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.field.hidden {
  display: none;
}

.upload-box {
  display: grid;
  gap: 16px;
  padding: 18px;
  border-radius: 20px;
  border: 1px dashed rgba(var(--accent-rgb), 0.3);
  background: rgba(var(--accent-rgb), 0.04);
}

.upload-box label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  border-radius: 14px;
  background: rgba(255,255,255,0.8);
  border: 1px solid rgba(122, 101, 219, 0.15);
  color: var(--purple-deep);
  font-weight: 800;
  cursor: pointer;
}

.upload-box input[type="file"] {
  display: none;
}

.ai-summary {
  min-height: 220px;
  background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.06), rgba(255,255,255,0.9));
  border: 1px solid rgba(122, 101, 219, 0.12);
  border-radius: 22px;
  padding: 18px;
}

.ai-summary h3 {
  margin-top: 0;
  color: var(--purple-deep);
}

.pdf-preview-shell {
  position: relative;
  min-height: 240px;
  border-radius: 18px;
  overflow: hidden;
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(122, 101, 219, 0.12);
}

.pdf-empty-state {
  display: grid;
  place-items: center;
  min-height: 240px;
  padding: 20px;
  text-align: center;
  color: var(--text-soft);
  font-weight: 700;
}

#pdfPreview {
  display: none;
  width: 100%;
  height: 360px;
  border: 0;
  background: var(--panel);
}

.summary-body {
  margin: 0;
  color: var(--text-soft);
  line-height: 1.7;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 10px;
}

/* Footer styles */
.site-footer {
  margin-top: 28px;
  padding: 26px 18px 14px;
  background: linear-gradient(180deg, rgba(74,60,150,0.06), rgba(255,255,255,0.6));
  border-radius: 18px;
  border: 1px solid rgba(122,101,219,0.08);
}

.footer-container {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 18px;
  align-items: start;
  max-width: 1200px;
  margin: 0 auto;
}

.footer-contact h4,
.footer-form h4 { margin: 0 0 8px; color: var(--purple-deep); }
.footer-contact p { margin: 6px 0; color: var(--text-soft); }
.footer-contact a { color: var(--purple); font-weight: 700; }

.footer-form form { display: grid; gap: 12px; }
.field-row { display: flex; gap: 10px; }
.field-row input[type="email"], .field-row input[type="tel"] {
  flex: 1;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--panel);
  outline: none;
}

.footer-bottom {
  margin-top: 12px;
  text-align: center;
  color: var(--text-soft);
  font-size: 0.92rem;
}

@media (max-width: 980px) {
  .profile-workspace,
  .team-grid,
  .guide-grid,
  .footer-container,
  .profile-detail-grid { grid-template-columns: 1fr; }
  .field-row { flex-direction: column; }
  .field-row input, .field-row button { width: 100%; }
  .mini-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .profile-header { grid-template-columns: 1fr; }
  .portrait-upload {
   justify-self: center;
   max-width: 260px;
   width: min(100%, 260px);
  }
}

@media (max-width: 640px) {
  .team-grid,
  .guide-grid,
  .mini-grid,
  .profile-detail-grid {
   grid-template-columns: 1fr;
  }

  .profile-header {
   display: grid;
   grid-template-columns: 1fr;
   gap: 12px;
  }

  .profile-header > .field {
   order: 1;
   width: 100%;
   max-width: 100%;
   justify-self: stretch;
  }

  .portrait-upload {
   order: 2;
   width: min(100%, 220px);
   max-width: 220px;
   justify-self: center;
   margin: 0 auto;
  }
}

/* End responsive tuning */

/* Minimalist high-end system overrides: fonts, color accents and button states */

/* Button system: Primary / Ghost / Auth */
.primary-btn,
.auth-btn-primary,
button.primary {
  background: var(--purple);
  color: #fff;
  box-shadow: 0 8px 18px var(--shadow);
  transition: transform 160ms ease, box-shadow 180ms ease, background-color 160ms ease, color 160ms ease;
}

.primary-btn:hover,
.auth-btn-primary:hover,
button.primary:hover {
  transform: translateY(-2px);
  background: var(--purple-deep);
  box-shadow: 0 12px 28px rgba(var(--accent-rgb), 0.14);
}

.primary-btn:active,
.auth-btn-primary:active,
button.primary:active {
  transform: translateY(1px);
  box-shadow: 0 6px 12px rgba(var(--accent-rgb), 0.08);
}

.primary-btn:disabled,
.auth-btn-primary:disabled,
button.primary:disabled {
  opacity: 0.5;
  pointer-events: none;
  background: var(--panel-soft);
  color: var(--text-soft);
  box-shadow: none;
}

/* Ghost / Outline buttons */
.ghost-btn,
button.ghost {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.ghost-btn:hover,
button.ghost:hover {
  background: var(--panel-soft);
  color: var(--purple-deep);
  transform: translateY(-1px);
}

.ghost-btn:active,
button.ghost:active {
  transform: translateY(1px);
}

.ghost-btn:disabled,
button.ghost:disabled {
  opacity: 0.5;
  pointer-events: none;
  color: var(--text-soft);
  border-color: var(--line);
}

/* Small auth button variants follow same rules */
.auth-btn { border-radius: 10px; }

/* Focus styles for accessibility */
button:focus-visible,
a[role="button"]:focus-visible {
  outline: none;
  box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.08);
}

/* End of minimalist overrides */

/* Global behavior for dead links and search visibility */
/* Disable anchors that are placeholders (href="#") so they don't act like real links */
a[href="#"] {
  pointer-events: none;
  cursor: default;
  opacity: 0.6;
  color: var(--text-soft);
}

/* Hide global search by default; pages that need it may add class .has-search to <body> */
.search-box { display: none !important; }
body.has-search .search-box { display: block !important; }

/* End additions */

/* Skill pill styles (replaces inline small tags in careers.html) */
.skill-row {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 10px;
}

.skill-pill {
  padding: 6px 8px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 0.86rem;
  display: inline-block;
}

.pill-indigo { background: var(--panel-soft); color: var(--purple-deep); }
.pill-amber  { background: var(--cream); color: var(--pink); }
.pill-teal   { background: var(--mint); color: var(--mint-deep); }
.pill-light  { background: rgba(230, 240, 255, 0.6); color: var(--purple-deep); }

.career-score { margin-left: auto; font-weight: 800; color: var(--purple-deep); }

/* Compact input used across development page (replaces inline input styles) */
.input-compact {
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--panel);
  outline: none;
  font: inherit;
}

.controls-row { display:flex; gap:12px; align-items:center; }
.controls-row .input-compact { flex: 1; }

/* Goal item layout classes */
.goal-header { display:flex; gap:10px; align-items:center; margin-bottom:6px; }
.goal-when { color: var(--text-soft); font-weight:700; }
.goal-category { background: rgba(43,58,140,0.08); padding:4px 8px; border-radius:8px; margin-left:auto; font-weight:700; }
.goal-note { margin:0; color: var(--text-soft); }

.timeline-actions { display:flex; flex-direction:column; gap:6px; align-items:flex-end; }

/* End added styles */

/* Fixed-width compact input variants */
.input-compact--fixed { width: 160px; flex: 0 0 auto; }
.input-compact--select { width: 180px; flex: 0 0 auto; }

/* Button states: Normal / Hover / Active / Disabled */
.primary-btn, .ghost-btn, .auth-btn, .nav-toggle, button {
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s;
}

.primary-btn:hover, .ghost-btn:hover, .auth-btn:hover, button:hover {
  transform: translateY(-1px);
}

.primary-btn:active, .ghost-btn:active, .auth-btn:active, button:active {
  transform: translateY(1px);
}

.primary-btn:disabled, .ghost-btn:disabled, .auth-btn:disabled, button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

/* Ensure upload button inside portrait upload is fit-content and styled */
.portrait-upload .upload-btn {
  width: fit-content;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 10px 16px;
  border-radius: 12px;
  font-weight: 800;
}

/* Progress fill using CSS variable --progress (value in percent without % sign or with) */
.progress-track .progress-fill,
.progress-bar .progress-fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--purple), var(--purple-deep));
  width: var(--progress, 0%);
}

/* Helper to set progress via inline style or JS (JS will set --progress on element) */


.team-panel {
  margin-top: 18px;
}

.page-hero {
  padding: 18px 8px 8px;
}

.eyebrow {
  display: inline-block;
  padding: 8px 10px;
  border-radius: 999px;
  background: rgba(var(--accent-rgb), 0.08);
  color: var(--purple);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.page-hero h1 {
  margin: 18px 0 10px;
  font-size: clamp(2.2rem, 3vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.06em;
  color: var(--purple-deep);
}

.page-hero .lead,
.content-panel p,
.stat-card p,
.career-card p,
.timeline-item p {
  color: var(--text-soft);
  line-height: 1.7;
}

.content-panel {
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(122, 101, 219, 0.12);
  border-radius: 26px;
  padding: 18px 20px 20px;
  box-shadow: 0 12px 24px rgba(106, 88, 188, 0.05);
}

.content-panel h2 {
  margin: 0 0 18px;
  font-size: clamp(1.5rem, 1.8vw, 2rem);
  letter-spacing: -0.04em;
  color: var(--purple-deep);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.field {
  display: grid;
  gap: 8px;
}

.field.wide {
  grid-column: 1 / -1;
}

.field label {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--text-soft);
}

.field input,
.field select,
.field textarea {
  width: 100%;
  min-height: 50px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(122, 101, 219, 0.15);
  background: rgba(255,255,255,0.8);
  color: var(--text);
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: rgba(var(--accent-rgb), 0.44);
  box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.08);
}

.field select {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, var(--purple) 50%), linear-gradient(135deg, var(--purple) 50%, transparent 50%);
  background-position: calc(100% - 18px) calc(50% - 3px), calc(100% - 12px) calc(50% - 3px);
  background-size: 6px 6px, 6px 6px;
  background-repeat: no-repeat;
  padding-right: 34px;
  cursor: pointer;
}

.field textarea {
  min-height: 120px;
  resize: vertical;
}

.info-grid,
.stats-grid,
.career-grid,
.profile-detail-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.profile-detail-grid .field {
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(122, 101, 219, 0.12);
  border-radius: 22px;
  padding: 18px;
}

.stat-card,
.career-card {
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(122, 101, 219, 0.12);
  border-radius: 22px;
  padding: 18px;
}

.stat-card h3,
.career-card h3 {
  margin: 0 0 8px;
  color: var(--purple-deep);
}

.stat-card .score-pill,
.career-card .score-pill {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(var(--accent-rgb), 0.1);
  color: var(--purple);
  font-size: 0.78rem;
  font-weight: 800;
  margin-top: 12px;
}

.progress-row {
  display: grid;
  gap: 8px;
  margin-top: 14px;
}

.progress-row .label {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-soft);
}

.progress-bar {
  height: 10px;
  border-radius: 999px;
  background: var(--panel-soft);
  overflow: hidden;
}

.progress-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--purple), var(--purple-deep));
}

.timeline {
  display: grid;
  gap: 14px;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(122, 101, 219, 0.12);
}

.timeline-badge {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.10), rgba(242, 157, 183, 0.06));
  color: var(--purple-deep);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.timeline-item strong {
  display: block;
  color: var(--text);
  margin-bottom: 4px;
}

.timeline-item .status {
  margin-left: auto;
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.75rem;
  font-weight: 800;
  background: rgba(63, 191, 143, 0.12);
  color: var(--success);
}

.timeline-item .status.pending {
  background: rgba(var(--accent-rgb), 0.06);
  color: var(--purple-deep);
}

.career-card {
  display: grid;
  gap: 10px;
}

.career-card .career-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--panel-soft), var(--panel));
  color: var(--purple-deep);
  font-size: 1.5rem;
  font-weight: 800;
}

.filter-row {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 16px;
}

.filter-row input {
  flex: 1;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid rgba(122, 101, 219, 0.15);
  border-radius: 14px;
  background: rgba(255,255,255,0.8);
}

.filter-row .primary-btn {
  min-width: 142px;
}

@media (max-width: 980px) {
  .form-grid,
  .info-grid,
  .stats-grid,
  .career-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .page-hero h1 {
    font-size: clamp(1.8rem, 7vw, 2.5rem);
  }

  .form-grid,
  .info-grid,
  .stats-grid,
  .career-grid {
    grid-template-columns: 1fr;
  }

  .filter-row {
    flex-direction: column;
  }

  .filter-row .primary-btn {
    width: 100%;
  }
}
/* Main header sticky override (force) */
.main-header, .topbar {
  position: sticky !important;
  top: 0 !important;
  background-color: #ffffff !important;
  z-index: 1000 !important;
}
/* Soft UI rounding enforcement — prefer 12px for content panels and tab/menu blocks.
   Opt-out per element by adding the class .no-radius if needed. */
:root {`r`n  --transition-menu: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); --soft-radius: 12px; }

/* Apply soft rounding to common content containers (does not target topbar/header) */
.panel,
.card,
.widget,
.box,
.module,
.tab,
.tabs,
.tab-list,
.tab-panel,
.tab-item,
.menu,
.menu-panel,
.dropdown,
.modal,
.settings-panel,
.progress-track,
.progress-fill,
.tool-card,
.mini-panel,
.user-menu,
.search-box,
.score-box,
.summary-item,
.hero-card,
.radar-wrap,
.tool-grid,
.tool-icon {
  border-radius: var(--soft-radius) !important;
}

/* Allow explicit opt-out */
.no-radius { border-radius: 0 !important; }
/* Menu adjustments: larger icons, smaller labels, desktop centering preserved */
.header-nav .nav-item .nav-ico { font-size: 22px; width: 26px; }
.header-nav .nav-item span:last-child { font-size: 13px; }

/* Mobile menu button (hidden on desktop) */
.mobile-menu-button { display: none; align-items: center; justify-content: center; width:44px; height:44px; border-radius:12px; border:1px solid rgba(var(--accent-rgb),0.12); background:var(--panel); color:var(--purple-deep); font-size:22px; cursor:pointer; }

/* Mobile overlay nav */
.mobile-nav-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display:flex; align-items:flex-start; justify-content:center; padding-top: 76px; z-index: 9999; }
.mobile-nav-overlay.hidden { display:none; }
.mobile-nav-overlay .mobile-nav { width: 94%; max-width: 360px; background: var(--panel); border-radius: 14px; padding: 12px; box-shadow: 0 18px 40px rgba(8,6,24,0.4); border:1px solid rgba(var(--accent-rgb),0.06); }
.mobile-nav-overlay .mobile-nav .nav-item { display:block; padding:14px 12px; border-radius:8px; margin-bottom:8px; color:var(--text); background:transparent; }
.mobile-nav-overlay .mobile-nav .nav-item:hover { background: rgba(var(--accent-rgb),0.04); color:var(--purple-deep); }

/* Show mobile button and hide desktop nav on small screens */
@media (max-width: 980px) {
  .mobile-menu-button { display: inline-flex; }
  .header-nav { display: none; }
}

/* Ensure desktop: nav centered between brand and auth */
@media (min-width: 981px) {
  .header-brand { flex: 0 0 auto; }
  .header-nav { flex: 1 1 auto; justify-content: center; }
  .header-auth { flex: 0 0 auto; }
}

/* Prevent body scroll when overlay open */
body.mobile-nav-open { overflow: hidden; }
/* Desktop: ensure header buttons don't overflow; reduce nav gap slightly */
@media (min-width: 981px) {
  .header-auth .auth-area { gap: 8px; }
  .header-nav { gap: 8px; }
}

/* Mobile-specific header layout: keep brand left, auth left of menu button on right */
@media (max-width: 980px) {
  .topbar { flex-direction: row; align-items: center; gap: 8px; }
  .header-brand { order: 1; }
  .header-auth { order: 2; display: flex; align-items: center; gap: 8px; }
  .mobile-menu-button { order: 3; margin-left: 6px; }
  /* Ensure auth area doesn't wrap */
  .auth-area { white-space: nowrap; display: flex; gap: 8px; }
  .auth-btn { height: 36px; padding: 0 10px; }

  /* Mobile overlay: nicer spacing between icon and label */
  .mobile-nav-overlay .mobile-nav .nav-item { display:flex; align-items:center; gap:12px; padding:12px 14px; }
  .mobile-nav-overlay .mobile-nav .nav-item .nav-ico { width:34px; height:34px; display:inline-grid; place-items:center; border-radius:8px; background: rgba(0,0,0,0.03); font-size:18px; }
  .mobile-nav-overlay .mobile-nav .nav-item span:last-child { font-size:15px; }
}
/* Desktop header button compact override: make auth buttons smaller without affecting hero buttons */
@media (min-width: 981px) {
  .header-auth .auth-btn {
    height: 32px !important;
    padding: 0 8px !important;
    font-size: 13px !important;
    border-radius: 8px !important;
    line-height: 1 !important;
  }
  .header-auth .auth-btn.primary-btn {
    padding: 0 10px !important;
  }
}

/* Subtle Motion: menu & auth interactions (from .github Subtle Motion rules) */
.header-nav .nav-item {
  transition: var(--transition-menu);
  position: relative;
  overflow: hidden;
  will-change: transform, background-color, color;
}
.header-nav .nav-item .nav-ico,
.header-nav .nav-item span {
  transition: var(--transition-menu);
}

.header-nav .nav-item:hover {
  background-color: var(--panel-soft, rgba(0,0,0,0.03));
  color: var(--purple);
  transform: translateY(-1px);
}

.header-nav .nav-item:active,
.header-nav .nav-item.active {
  background-color: rgba(var(--accent-rgb), 0.08);
  transform: translateY(0) scale(0.98);
  font-weight: 700;
}

/* Auth buttons subtle motion */
.auth-btn,
.auth-btn.primary-btn,
.auth-btn.ghost-btn {
  transition: var(--transition-menu);
  will-change: transform, background-color;
}

.auth-btn:hover {
  transform: translateY(-1px);
  background-color: rgba(var(--accent-rgb), 0.04);
}

.auth-btn:active {
  transform: scale(0.96) translateY(1px);
}


/* Override: active = light blue, hover = darker blue for header nav items */
.header-nav .nav-item.active {
  background-color: rgba(var(--accent-rgb), 0.10) !important; /* light blue */
  color: var(--purple-deep) !important;
  box-shadow: none !important;
  transform: translateY(0) scale(1) !important;
}

.header-nav .nav-item:hover {
  background-color: rgba(var(--accent-rgb), 0.18) !important; /* darker on hover */
  color: var(--purple-deep) !important;
  transform: translateY(-1px) !important;
}

/* Ensure icon color follows text color on hover/active */
.header-nav .nav-item:hover .nav-ico,
.header-nav .nav-item.active .nav-ico {
  color: var(--purple-deep) !important;
}
