# SQLite is the local default. Use PostgreSQL for deployment.
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/axis
ENVIRONMENT=development
# Set a long random value in each deployed environment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_NAME=axis_access_token
COOKIE_SECURE=false
# Comma-separated exact origins; never use "*" with cookie credentials.
# Include the app host and the static preview ports used locally.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://192.168.1.91:8000,http://192.168.1.91:5500
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Maximum AI roadmap requests per authenticated user and rolling window.
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=60
